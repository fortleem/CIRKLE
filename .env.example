# ── CIRKLE Brain AI — Environment Variables ─────────────────────────────────
# Copy this file to .env and fill in your API keys.
# All AI provider keys are optional — the Brain works with any subset.
# Do NOT commit .env to git (it's in .gitignore).

# Database (SQLite — zero config)
DATABASE_URL=file:./db/custom.db

# ── AI Providers (4 for news + 1 for non-news) ──────────────────────────────

# Groq — fastest provider, great for Arabic
# Free tier: https://console.groq.com
GROQ_API_KEY=

# Gemini — vision, reasoning, Google Search grounding
# Free tier: https://aistudio.google.com
GEMINI_API_KEY=

# OpenRouter — web search via :online model suffix
# Free tier: https://openrouter.ai
OPENROUTER_API_KEY=

# HuggingFace — free tier, Mistral-7B
# Free tier: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=

# OpenAI — strong reasoning (used for non-news Brain functions only)
# Paid: https://platform.openai.com
OPENAI_API_KEY=

# ── Optional: Production ─────────────────────────────────────────────────────
# NODE_ENV=production
# VERCEL=1
