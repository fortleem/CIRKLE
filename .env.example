# ── CIRKLE Brain AI — Environment Variables ─────────────────────────────────
# Copy this file to .env and fill in your API keys.

# Database (Turso for production, local SQLite for dev)
DATABASE_URL=file:./db/custom.db
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=your-turso-token

# AI Providers
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
HUGGINGFACE_API_KEY=
OPENAI_API_KEY=
