// CIRKLE — Prisma schema
// Database: Turso (libsql) — synced across GitHub, Vercel, and Turso
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// A Circle user. One account per human (enforced by Circle Verify).
model User {
  id           String   @id @default(cuid())
  circleId     String   @unique // @layla:matrix.circle.app
  displayName  String
  arabicName   String?
  avatarColor  String   @default("teal") // teal|rose|steel|gold|charcoal
  verified     Boolean  @default(false)
  region       String   @default("EG")
  joinedAt     DateTime @default(now())
  conversations ConversationMember[]
  posts        Post[]
  messages     Message[]
  transactions Transaction[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// 1:1, group, or channel conversations (Wasl).
model Conversation {
  id           String   @id @default(cuid())
  type         String   @default("direct") // direct|group|channel
  name         String
  arabicName   String?
  avatarColor  String   @default("teal")
  encrypted    Boolean  @default(true)
  participants ConversationMember[]
  messages     Message[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([type])
}

model ConversationMember {
  id              String   @id @default(cuid())
  conversationId  String
  userId          String?
  displayName     String
  avatarColor     String   @default("teal")
  initials        String
  presence        String   @default("offline") // online|away|offline|ghost
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user            User?    @relation(fields: [userId], references: [id])
  joinedAt        DateTime @default(now())

  @@unique([conversationId, displayName])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String?
  senderName     String
  senderInitials String
  senderColor    String   @default("teal")
  // `body` holds the message text. For E2EE messages (encrypted=true) the
  // server stores ONLY the opaque `ciphertext` payload here and `body` is
  // null — the server never sees plaintext. For non-encrypted / system
  // messages, `body` carries the plaintext as before. The server NEVER
  // decrypts `ciphertext`; only the recipient's client can.
  body           String?
  // Opaque E2EE ciphertext blob (JSON envelope from src/lib/e2ee-service.ts).
  // The server treats this as an opaque string; it is never parsed, logged,
  // or decrypted server-side. See ADR-002 §5.3.
  ciphertext     String?
  status         String   @default("sent") // pending|sent|delivered|read
  encrypted      Boolean  @default(true)
  replyToId      String?
  attachmentKind String?  // image|audio|file|location|payment
  attachmentName String?
  attachmentUrl  String?
  attachmentMime String?
  attachmentSize Int?
  systemEvent    String?
  editedAt       DateTime?
  deletedAt      DateTime?
  isDeleted      Boolean  @default(false)
  forwardedFromId String?
  isStarred      Boolean  @default(false)
  starredAt      DateTime?
  isPinned       Boolean  @default(false)
  threadId       String?
  ttlSeconds     Int?     // disappearing messages
  expiresAt      DateTime?
  createdAt      DateTime @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User?    @relation(fields: [senderId], references: [id])
  reactions      Reaction[]

  @@index([conversationId, createdAt])
  @@index([conversationId, isPinned])
  @@index([conversationId, isStarred])
  @@index([expiresAt])
}

model Reaction {
  id           String   @id @default(cuid())
  messageId    String
  userId       String?
  displayName  String
  emoji        String
  createdAt    DateTime @default(now())
  message      Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, displayName, emoji])
  @@index([messageId])
}

/// Public posts (Midan microblog + Lamahat photos + Mashahd shares).
model Post {
  id           String   @id @default(cuid())
  authorId     String?
  authorName   String
  authorHandle String
  authorInitials String
  authorColor  String   @default("teal")
  authorVerified Boolean @default(false)
  body         String
  arabicBody   String?
  module       String   @default("midan") // midan|lamahat|mashahd|circle
  visibility   String   @default("public") // public|followers|circle|anonymous
  /// P1.6 — Anonymous Midan. When this post was published anonymously,
  /// this field holds the per-Circle pseudonymous ID (e.g.
  /// "anonymous-falcon-42-midan"). `authorId` is null in that case —
  /// there is NO server-side mapping back to a real user.
  anonymousId  String?
  location     String?
  language     String   @default("en")
  likes        Int      @default(0)
  comments     Int      @default(0)
  shares       Int      @default(0)
  views        Int      @default(0)
  tags         String?  // comma-separated
  mediaKind    String?  // image|video|album|gif
  mediaCount   Int?
  mediaCover   String?
  author       User?    @relation(fields: [authorId], references: [id])
  createdAt    DateTime @default(now())

  @@index([module, createdAt])
  @@index([authorHandle])
  @@index([anonymousId])
}

/// Citizen Shield reports (zero-knowledge, tamper-evident).
model ShieldReport {
  id                    String   @id @default(cuid())
  caseNumber            String   @unique
  category              String
  title                 String
  description           String
  officeName            String
  officeRegion          String
  privacyLevel          String   @default("protected") // identified|protected|anonymous
  evidenceHashes        String   @default("[]") // JSON array of SHA-256 hashes
  ipfsHashes            String   @default("[]") // JSON array of IPFS content hashes
  status                String   @default("pending") // pending|investigating|escalated|resolved|auto-published
  escalationLevel       Int      @default(1)
  aiSummary             String?
  aiRoute               String?
  aiLocalAuthority      String?
  aiLegalFramework      String?
  chainOfCustody        String   @default("[]") // JSON array of chain entries
  witnessCount          Int      @default(0)
  deadManSwitchEnabled  Boolean  @default(false)
  deadManLastCheckIn    DateTime?
  deadManTimeoutMinutes Int      @default(5)
  deadManTriggered      Boolean  @default(false)
  ephemeralPublicKey    String? // for anonymous reports
  encryptedEvidenceKey  String? // AES key encrypted with ephemeral key
  // ── Civic Wave Publishing ──
  publishToMidan        Boolean  @default(false) // post to Midan (social feed)
  publishToMashahd      Boolean  @default(false) // post to Mashahd (video evidence)
  publishPublicLink     Boolean  @default(false) // generate shareable public link
  publishedPostId       String? // linked Post ID if published to Midan
  publishedAt           DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([status])
  @@index([category])
  @@index([officeName])
  @@index([publishToMidan])
}

/// Circle Verify attestations (zero-knowledge claims).
/// Backs `src/lib/identity.ts` — HMAC-SHA256 signed, nullifier-deduped.
model VerifyClaim {
  id         String   @id @default(cuid())
  userId     String?
  userLabel  String
  type       String   // over_18|nationality|professional|unique_human
  label      String
  claimValue String   @default("") // canonical claim value: "true"|"EG"|"engineer"|...
  status     String   @default("verified") // verified|pending|revoked
  attestor   String
  // ZK attestation fields (HMAC-SHA256 signature + nullifier for dedup)
  signature  String?  // HMAC-SHA256 hex of canonical claim payload
  nullifier  String?  // hash(username + claimType) — dedup without revealing username
  revokedAt  DateTime?
  expiresAt  DateTime?
  issuedAt   DateTime @default(now())

  @@index([userLabel])
  @@index([type, status])
  @@index([nullifier])
}

/// Circle Payments ledger (non-custodial; reflects on-chain / gateway settlements).
model Transaction {
  id                 String   @id @default(cuid())
  userLabel          String
  direction          String   // in|out
  counterparty       String
  counterpartyInitials String
  counterpartyColor  String   @default("teal")
  amount             Float
  currency           String   @default("EGP")
  method             String   // fawry|vodafone-cash|instapay|wechat|alipay|upi|usdc|qr
  memo               String?
  status             String   @default("settled") // settled|pending|failed
  fee                Float    @default(0)
  userId             String?
  user               User?    @relation(fields: [userId], references: [id])
  createdAt          DateTime @default(now())

  @@index([userId, createdAt])
}

/// Travel itineraries generated by the AI planner.
model TravelItinerary {
  id           String   @id @default(cuid())
  destination  String
  days         Int
  startDate    String
  travelers    Int
  budget       String
  interests    String   // comma-separated
  payload      String   // JSON of days_data
  createdAt    DateTime @default(now())
}

/// Cirkle Oracle prediction markets — LMSR automated market maker.
model PredictionMarket {
  id                String   @id @default(cuid())
  question          String
  category          String   // news|sports|politics|crypto|travel|weather|visa|social
  resolutionDate    DateTime
  outcomes          String   // JSON array of {id,label,shares,probability}
  totalVolume       Float    @default(0)
  resolved          Boolean  @default(false)
  resolutionOutcome String?
  liquidityParam    Float    @default(100) // LMSR b parameter
  createdAt         DateTime @default(now())
  createdBy         String
  bets              PredictionBet[]

  @@index([category, resolved])
  @@index([resolutionDate])
}

/// A bet placed on a PredictionMarket outcome.
model PredictionBet {
  id        String   @id @default(cuid())
  marketId  String
  market    PredictionMarket @relation(fields: [marketId], references: [id], onDelete: Cascade)
  username  String
  outcomeId String
  shares    Float
  amount    Float
  currency  String   @default("EGP")
  createdAt DateTime @default(now())

  @@index([marketId, createdAt])
  @@index([username])
}


model App {
  id            String   @id @default(cuid())
  appId         String   @unique
  name          String
  description   String
  developer     String
  websiteUrl    String?
  logoEmoji     String   @default("🔌")
  category      String   @default("general")
  status        String   @default("active")
  scopes        String   @default("feed:read")
  redirectUris  String   @default("")
  webhookUrl    String?
  webhookSecret String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  apiKeys       ApiKey[]
  connections   AppConnection[]
  events        WebhookEvent[]
  @@index([status, category])
}

model ApiKey {
  id          String   @id @default(cuid())
  keyId       String   @unique
  keyHash     String   @unique
  appId       String
  name        String   @default("Default")
  tier        String   @default("free")
  scopes      String   @default("feed:read")
  status      String   @default("active")
  lastUsedAt  DateTime?
  requestCount Int     @default(0)
  rateLimitPerMin Int  @default(60)
  createdAt   DateTime @default(now())
  app         App      @relation(fields: [appId], references: [id], onDelete: Cascade)
  @@index([appId, status])
}

model AppConnection {
  id          String   @id @default(cuid())
  appId       String
  userLabel   String
  scopes      String
  status      String   @default("active")
  authCode    String?
  accessToken String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  app         App      @relation(fields: [appId], references: [id], onDelete: Cascade)
  @@unique([appId, userLabel])
}

model WebhookEvent {
  id          String   @id @default(cuid())
  appId       String
  eventType   String
  payload     String
  status      String   @default("pending")
  attempts    Int      @default(0)
  createdAt   DateTime @default(now())
  app         App      @relation(fields: [appId], references: [id], onDelete: Cascade)
  @@index([appId, status])
}

/// VoIP / Video call session log (Cirkle Call).
/// WebRTC signaling flows through the chat-service socket.io (port 3003) —
/// SDP/ICE candidates are NEVER persisted to the database.
model CallSession {
  id        String   @id @default(cuid())
  caller    String
  callee    String
  type      String   // "voice" | "video"
  status    String   @default("ringing") // ringing | accepted | rejected | ended | missed
  startedAt DateTime?
  endedAt   DateTime?
  createdAt DateTime @default(now())

  @@index([caller, createdAt])
  @@index([callee, createdAt])
  @@index([status])
}

/// Data Subject Request intake (GDPR Article 15–21 / PDPL / CCPA).
model DataSubjectRequest {
  id        String   @id @default(cuid())
  username  String
  type      String   // access | correction | deletion | portability | objection
  details   String?
  status    String   @default("pending") // pending | in_progress | fulfilled | rejected
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([username])
  @@index([status])
}

/// Creator monetization profile. One per username.
model CreatorProfile {
  id              String   @id @default(cuid())
  username        String   @unique
  verified        Boolean  @default(false)
  monetized       Boolean  @default(false)
  tier            String   @default("bronze") // bronze | silver | gold | platinum
  totalEarnings   Float    @default(0)
  totalSupporters Int      @default(0)
  payoutMethod    String?  // "cirkle_pay" | "bank" | "crypto"
  payoutDetails   String?  // opaque JSON blob (treated as encrypted at rest)
  // Optional support tier amounts (one-off Commit micropayments).
  basicAmount     Float    @default(5)
  premiumAmount   Float    @default(20)
  vipAmount       Float    @default(100)
  currency        String   @default("SAR")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

/// One-off support (Commit micropayment) from a supporter to a creator.
model CreatorSupport {
  id        String   @id @default(cuid())
  creator   String   // username
  supporter String   // username
  amount    Float
  currency  String
  message   String?
  createdAt DateTime @default(now())

  @@index([creator, createdAt])
  @@index([supporter])
}

/// Recurring monthly subscription from a subscriber to a creator.
model Subscription {
  id         String   @id @default(cuid())
  creator    String   // username
  subscriber String   // username
  tier       String   @default("basic") // basic | premium | vip
  amount     Float    // monthly
  currency   String
  status     String   @default("active") // active | cancelled | expired
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([creator, subscriber])
  @@index([subscriber, status])
}

/// Directed follow edge in the social graph.
model Follow {
  id        String   @id @default(cuid())
  follower  String   // username
  following String   // username
  createdAt DateTime @default(now())

  @@unique([follower, following])
  @@index([following])
}

/// Per-user per-post interaction record. Powers the algorithmic feed.
model PostInteraction {
  id        String   @id @default(cuid())
  username  String
  postId    String
  type      String   // "view" | "like" | "comment" | "share" | "dwell"
  dwellMs   Int?     // for dwell tracking
  createdAt DateTime @default(now())

  @@unique([username, postId, type])
  @@index([username, createdAt])
  @@index([postId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Professional Network (Blueprint §14) — LinkedIn replacement.
// Job postings, applications, profiles, skill endorsements, salary insights.
// ─────────────────────────────────────────────────────────────────────────────

/// A job posting (full-time | part-time | contract | internship).
model JobPosting {
  id           String   @id @default(cuid())
  title        String
  company      String
  location     String
  country      String
  type         String   // full-time | part-time | contract | internship
  salaryMin    Float?
  salaryMax    Float?
  currency     String?
  description  String
  requirements String
  postedBy     String
  createdAt    DateTime @default(now())
  applications JobApplication[]

  @@index([country, createdAt])
  @@index([type, createdAt])
  @@index([postedBy])
}

/// An application to a JobPosting.
model JobApplication {
  id          String   @id @default(cuid())
  jobId       String
  job         JobPosting @relation(fields: [jobId], references: [id], onDelete: Cascade)
  username    String
  coverLetter String?
  status      String   @default("pending") // pending | reviewed | accepted | rejected
  createdAt   DateTime @default(now())

  @@unique([jobId, username])
  @@index([username, createdAt])
}

/// A professional profile (one per username). skills/experience/education
/// are stored as JSON-encoded arrays (Prisma SQLite has no native list type).
model ProProfile {
  username     String   @id
  headline     String?
  summary      String?
  skills       String   // JSON array of strings
  experience   String   // JSON array of {role, company, start, end, description}
  education    String   // JSON array of {school, degree, start, end}
  availability String   @default("open") // open | looking | closed
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// A skill endorsement (target user + skill + endorsing user).
model Endorsement {
  id        String   @id @default(cuid())
  target    String   // username being endorsed
  skill     String
  endorser  String   // username giving the endorsement
  createdAt DateTime @default(now())

  @@unique([target, skill, endorser])
  @@index([target])
  @@index([skill])
}

// ─────────────────────────────────────────────────────────────────────────────
// Circle Mail (Blueprint §20) — @cirkle.app email client.
// Internal-only mail (username → username). AI triage via /api/ai/summarize.
// ─────────────────────────────────────────────────────────────────────────────

/// A mail message between two Cirkle users (internal @cirkle.app addresses).
model MailMessage {
  id           String   @id @default(cuid())
  toUsername   String
  fromUsername String
  fromEmail    String
  subject      String
  body         String
  read         Boolean  @default(false)
  starred      Boolean  @default(false)
  folder       String   @default("inbox") // inbox | sent | draft | trash
  createdAt    DateTime @default(now())

  @@index([toUsername, folder])
  @@index([fromUsername, folder])
  @@index([starred])
}

/// Polls & Quizzes — Blueprint §9.3, §10.5.2.
/// `options` is a JSON array of `{ id, text }`. Voting is one-vote-per-user
/// (enforced by the `@@unique([pollId, username])` on `PollVote`).
model Poll {
  id        String   @id @default(cuid())
  question  String
  options   String   // JSON array of { id, text }
  createdBy String
  duration  Int      // seconds
  createdAt DateTime @default(now())
  expiresAt DateTime
  postId    String?
  votes     PollVote[]

  @@index([createdBy])
  @@index([expiresAt])
}

model PollVote {
  id        String   @id @default(cuid())
  pollId    String
  poll      Poll     @relation(fields: [pollId], references: [id], onDelete: Cascade)
  username  String
  optionId  String
  votedAt   DateTime @default(now())

  @@unique([pollId, username])
  @@index([pollId, optionId])
}

/// Bullet Comments / Danmaku — Blueprint §26.10.
/// Bilibili-style scrolling comments overlaid on video. `timestamp` is the
/// video position (seconds) at which the bullet should appear.
model BulletComment {
  id        String   @id @default(cuid())
  postId    String
  username  String
  text      String
  color     String   @default("white")
  timestamp Float    // video timestamp in seconds
  createdAt DateTime @default(now())

  @@index([postId, timestamp])
}

/// Family Vault — Blueprint §26.6.
/// `members` is a JSON array of usernames. Each `VaultItem` is encrypted on
/// the client with a key derived from the family passphrase before upload —
/// the server never sees the plaintext.
model FamilyVault {
  id        String   @id @default(cuid())
  name      String
  members   String   // JSON array of usernames
  createdBy String
  createdAt DateTime @default(now())

  @@index([createdBy])
}

model VaultItem {
  id            String   @id @default(cuid())
  familyId      String
  type          String   // photo | video | document | note
  title         String
  encryptedData String   // AES-256 encrypted (key derived from family passphrase)
  uploadedBy    String
  createdAt     DateTime @default(now())

  @@index([familyId])
}

/// Decentralised Ticketing — Blueprint §26.7.
/// Ed25519-signed offline event tickets. The `signature` is the Ed25519
/// signature over the canonical ticket payload — verifiable offline by
/// anyone holding the issuer's public key.
model EventTicket {
  id        String   @id @default(cuid())
  eventName String
  eventDate DateTime
  venue     String
  seat      String
  holder    String
  price     Float
  currency  String
  signature String
  issuer    String
  createdAt DateTime @default(now())

  @@index([holder])
}

/// ───────────────────────────────────────────────────────────────────────────
/// Local Ads Server — Blueprint §7.3.1, §30.
/// Non-targeted local ads paid via corporate invoice. This is Cirkle's only
/// revenue model. NO user profiling — only country + city + category are
/// used to select an ad, in compliance with the privacy-first blueprint.
/// ───────────────────────────────────────────────────────────────────────────
model AdCampaign {
  id            String   @id @default(cuid())
  advertiser    String
  title         String
  body          String
  cta           String
  url           String
  targetCountry String
  targetCity    String?
  category      String   // news | sports | tech | education | retail | food | travel
  budget        Float
  spent         Float    @default(0)
  impressions   Int      @default(0)
  clicks        Int      @default(0)
  cpm           Float    // cost per mille (per 1,000 impressions)
  startDate     DateTime
  endDate       DateTime
  status        String   @default("active") // active | paused | ended | exhausted
  createdAt     DateTime @default(now())

  @@index([advertiser])
  @@index([targetCountry, category, status])
  @@index([status, startDate, endDate])
}

model AdInvoice {
  id         String    @id @default(cuid())
  advertiser String
  amount     Float
  currency   String
  status     String    @default("pending") // pending | paid | overdue
  campaigns  String    // JSON array of campaign IDs
  createdAt  DateTime  @default(now())
  paidAt     DateTime?

  @@index([advertiser, status])
}

/// ───────────────────────────────────────────────────────────────────────────
/// Educational Workspaces — Blueprint §12.
/// Free for schools, K-12, universities. Teachers create classes, post
/// assignments, grade submissions, and mark attendance. Students submit
/// work and view their grades + attendance.
/// ───────────────────────────────────────────────────────────────────────────
model EduClass {
  id          String   @id @default(cuid())
  name        String
  institution String
  teacher     String
  students    String   // JSON array of usernames
  createdAt   DateTime @default(now())

  @@index([teacher])
}

model Assignment {
  id          String   @id @default(cuid())
  classId     String
  title       String
  description String
  dueDate     DateTime
  createdBy   String
  createdAt   DateTime @default(now())
  submissions Submission[]

  @@index([classId, dueDate])
  @@index([createdBy])
}

model Submission {
  id              String   @id @default(cuid())
  assignmentId    String
  assignment      Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentUsername String
  content         String
  grade           Float?
  feedback        String?
  submittedAt     DateTime @default(now())

  @@unique([assignmentId, studentUsername])
  @@index([studentUsername])
}

model AttendanceRecord {
  id              String   @id @default(cuid())
  classId         String
  studentUsername String
  date            DateTime
  status          String   // present | absent | late | excused
  recordedBy      String
  createdAt       DateTime @default(now())

  @@unique([classId, studentUsername, date])
  @@index([classId, date])
}

/// ───────────────────────────────────────────────────────────────────────────
/// Knowledge Wiki — Blueprint §10.5.5, §26.4.
/// IPFS-backed Markdown wikis inside any Circle. Each page is versioned —
/// updates create a new WikiPageVersion row so the full history is
/// preserved and diffs are queryable.
/// ───────────────────────────────────────────────────────────────────────────
model WikiPage {
  id        String   @id @default(cuid())
  circleId  String
  slug      String
  title     String
  content   String   // Markdown
  author    String
  version   Int      @default(1)
  ipfsHash  String?  // optional IPFS content hash (blueprint §26.4)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([circleId, slug])
  @@index([circleId, updatedAt])
  versions WikiPageVersion[]
}

model WikiPageVersion {
  id        String   @id @default(cuid())
  pageId    String
  page      WikiPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  version   Int
  title     String
  content   String
  author    String
  ipfsHash  String?
  createdAt DateTime @default(now())

  @@unique([pageId, version])
  @@index([pageId, version])
}

/// In-app feedback submitted from overlay headers (R10).
model Feedback {
  id        String   @id @default(cuid())
  overlay   String
  message   String
  username  String?
  createdAt DateTime @default(now())

  @@index([overlay, createdAt])
}


// ============================================================

// ============================================================
// CIRKLE Brain AI — Phase Persistence Models (Upgrade 1)
// ============================================================

/// LIEE: AI feedback signals for continuous learning.
model AIFeedback {
  id              String   @id @default(cuid())
  feedbackId      String   @unique
  pipeline        String   // explicit | implicit | behavioral | operational | execution | satisfaction
  sourcePhase     String   // gcie | pmb | crie | irde | uob | tee | liee | cie | user
  userId          String?
  targetEntityId  String?
  targetType      String   // recommendation | capability | plan | step | workflow | search | provider
  valence         String   // positive | negative | neutral
  normalizedScore Float    @default(0.5)
  raw             Json?
  consentGranted  Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@index([pipeline, createdAt])
  @@index([sourcePhase, createdAt])
  @@index([userId, createdAt])
}

/// TGSE: Immutable audit records (cryptographically chained).
model AuditRecord {
  id            String   @id @default(cuid())
  auditId       String   @unique
  timestamp     DateTime @default(now())
  eventType     String   // governance-decision | policy-evaluated | etc.
  target        String   // crie | irde | uob | tee | liee | cie
  decision      String?  // approve | deny | require-approval | warn | defer
  description   String
  data          Json?
  hash          String
  previousHash  String?

  @@index([eventType, timestamp])
  @@index([target, timestamp])
}

/// TGSE: Governance decisions.
model GovernanceDecision {
  id                    String   @id @default(cuid())
  decisionId            String   @unique
  target                String
  decision              String   // approve | deny | require-approval | warn | defer
  timestamp             DateTime @default(now())
  policiesEvaluated     Json?
  permissionsChecked    Json?
  risksIdentified       Json?
  requiresHumanApproval Boolean  @default(false)
  approvalRequestId     String?
  explanationSummary    String
  explanationPolicy     Json?
  explanationPermission Json?
  explanationRisk       Json?
  explanationApproval   Json?
  confidence            Float    @default(0.5)
  actionContext         Json?

  @@index([target, timestamp])
  @@index([decision, timestamp])
}

/// TGSE: Human approval requests.
model ApprovalRequest {
  id                  String    @id @default(cuid())
  requestId           String    @unique
  trigger             String    // high-value-payment | government-submission | etc.
  target              String
  actionContext       Json?
  requiredApproverRole String
  status              String    @default("pending") // pending | approved | rejected | expired | escalated
  approver            String?
  decidedAt           DateTime?
  notes               String?
  createdAt           DateTime  @default(now())
  expiresAt           DateTime?
  escalationChain     Json?

  @@index([status, createdAt])
  @@index([target, createdAt])
}

/// TEE: Execution records.
model ExecutionRecord {
  id              String   @id @default(cuid())
  executionId     String   @unique
  planId          String
  state           String   // pending | running | completed | failed | cancelled | timed-out
  startedAt       DateTime @default(now())
  completedAt     DateTime?
  totalDurationMs Int      @default(0)
  stepsJson       Json?    // steps array
  telemetryJson   Json?    // telemetry
  outputsJson     Json?    // outputs
  auditTrailJson  Json?    // audit trail
  dryRun          Boolean  @default(true)
  summary         String   @default("")
  errorsJson      Json?
  userId          String?

  @@index([planId, startedAt])
  @@index([state, startedAt])
  @@index([userId, startedAt])
}

/// AHG: Account problems.
model AccountProblem {
  id              String    @id @default(cuid())
  problemId       String    @unique
  type            String    // payment-failed | account-locked | etc.
  severity        String    // low | medium | high | critical
  status          String    @default("detected")
  userId          String
  description     String
  rootCauseJson   Json?
  proposedFixesJson Json?
  consentJson     Json?
  executionResultJson Json?
  resolvedAt      DateTime?
  metadataJson    Json?
  detectedAt      DateTime  @default(now())

  @@index([userId, detectedAt])
  @@index([status, detectedAt])
  @@index([type, detectedAt])
}

/// Upgrade 9: AI response cache.
model AIResponseCache {
  id        String   @id @default(cuid())
  cacheKey  String   @unique
  query     String
  response  Json
  provider  String
  confidence Float
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([cacheKey, expiresAt])
  @@index([expiresAt])
}

/// Upgrade 11: Multi-tenant enterprise isolation.
model Tenant {
  id          String   @id @default(cuid())
  tenantId    String   @unique
  name        String
  plan        String   @default("free") // free | pro | enterprise
  createdAt   DateTime @default(now())
  settings    Json?

  @@index([tenantId])
}

model TenantMember {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  role      String   @default("member") // admin | member | viewer
  createdAt DateTime @default(now())

  @@unique([tenantId, userId])
  @@index([tenantId])
}

/// Upgrade 12: Push notification tokens.
model PushToken {
  id        String   @id @default(cuid())
  userId    String
  token     String
  platform  String   // ios | android | web
  createdAt DateTime @default(now())
  active    Boolean  @default(true)

  @@index([userId, active])
}

// ── Phase 7.5: Autonomous Intelligence & Knowledge Engine (AIKE) ────────────

/// Knowledge graph nodes — the central intelligence memory.
model AikeKnowledgeNode {
  id            String   @id @default(cuid())
  nodeId        String   @unique
  type          String   // user | place | business | product | hotel | flight | ...
  name          String
  properties    Json
  trustScore    Float    @default(50)
  confidence    Float    @default(0.5)
  discoveredAt  DateTime @default(now())
  updatedAt     DateTime @updatedAt
  sourceIds     String   @default("[]")
  tags          String   @default("[]")

  @@index([type])
  @@index([name])
}

/// Knowledge graph edges — relationships between nodes.
model AikeKnowledgeEdge {
  id              String   @id @default(cuid())
  edgeId          String   @unique
  fromNodeId      String
  toNodeId        String
  type            String   // visited | liked | purchased | works_at | located_in | ...
  weight          Float    @default(0.5)
  properties      Json
  firstObservedAt DateTime @default(now())
  lastObservedAt  DateTime @updatedAt
  observationCount Int     @default(1)

  @@index([fromNodeId])
  @@index([toNodeId])
  @@index([type])
}

/// Validated knowledge facts with confidence + trust scoring.
model AikeKnowledgeFact {
  id               String   @id @default(cuid())
  factId           String   @unique
  statement        String
  domain           String
  value            Json
  sources          Json     // KnowledgeSourceRef[]
  confidence       Float    @default(0.5)
  trustScore       Float    @default(50)
  verificationCount Int     @default(0)
  contradictions   String   @default("[]")
  lastCheckedAt    DateTime @default(now())
  expiresAt        DateTime
  status           String   @default("unvalidated") // validated | unvalidated | contradicted | expired | deprecated

  @@index([domain])
  @@index([status])
  @@index([expiresAt])
}

/// Detected knowledge gaps that need research.
model AikeKnowledgeGap {
  id                String   @id @default(cuid())
  gapId             String   @unique
  domain            String
  description       String
  triggerQuery      String?
  encounterCount    Int      @default(1)
  firstEncounteredAt DateTime @default(now())
  lastEncounteredAt  DateTime @updatedAt
  priority          Float    @default(0.5)
  researchScheduled Boolean  @default(false)
  status            String   @default("open") // open | researching | resolved | unresolvable

  @@index([domain, status])
  @@index([priority])
}

/// Autonomous research tasks scheduled by the research scheduler.
model AikeResearchTask {
  id            String   @id @default(cuid())
  taskId        String   @unique
  gapId         String?
  query         String
  domain        String
  priority      String   @default("medium") // critical | high | medium | low | background
  targetSources String   @default("[]")
  status        String   @default("pending") // pending | in_progress | completed | failed | cancelled
  scheduledFor  DateTime
  startedAt     DateTime?
  completedAt   DateTime?
  results       Json?
  error         String?
  retryCount    Int      @default(0)

  @@index([status, scheduledFor])
  @@index([priority])
}

/// Continuously-updated world state entries.
model AikeWorldStateEntry {
  id                String   @id @default(cuid())
  entryId           String   @unique
  metric            String   // weather | traffic | currency | fuel_prices | ...
  scope             String   // country code, city, or "global"
  value             Json
  source            String
  refreshedAt       DateTime @default(now())
  expiresAt         DateTime
  refreshIntervalMs BigInt
  active            Boolean  @default(true)

  @@index([metric, scope, active])
  @@index([expiresAt])
}

/// Platform events ingested by the Event Learning Engine.
model AikePlatformEvent {
  id             String   @id @default(cuid())
  eventId        String   @unique
  category       String   // travel | restaurant | payment | messaging | feed | ...
  type           String   // Travel.Booked | Payment.Completed | ...
  timestamp      DateTime @default(now())
  userId         String?
  entityIds      String   @default("[]")
  payload        Json
  consentGranted Boolean  @default(true)
  sessionId      String?

  @@index([category, timestamp])
  @@index([userId, timestamp])
  @@index([sessionId])
}

/// User journey patterns learned by Experience Replay.
model AikeUserJourney {
  id              String   @id @default(cuid())
  journeyId       String   @unique
  userId          String?
  steps           Json     // JourneyStep[]
  outcome         String   // success | failure | abandoned | in_progress
  totalDurationMs BigInt
  startedAt       DateTime @default(now())
  endedAt         DateTime?
  category        String   // travel_booking | restaurant_discovery | ...
  confidence      Float    @default(0.5)

  @@index([userId, category])
  @@index([outcome])
}

/// Predictions generated by the Prediction Engine.
model AikePrediction {
  id           String   @id @default(cuid())
  predictionId String   @unique
  userId       String?
  type         String   // next_destination | next_restaurant | next_payment | ...
  predicted    Json
  confidence   Float    @default(0.5)
  timeHorizon  String
  reasoning    String
  evidence     String   @default("[]")
  createdAt    DateTime @default(now())
  fulfilledAt  DateTime?
  correct      Boolean?

  @@index([userId, type])
  @@index([createdAt])
}

/// Domain-specific learned knowledge (one per domain trainer).
model AikeDomainKnowledge {
  id               String   @id @default(cuid())
  domain           String   @unique // travel | payments | messaging | feed | ...
  facts            Json
  patterns         Json
  recommendationModel Json
  predictionModel  Json
  ranking          Json
  confidence       Float    @default(0.5)
  lastTrainedAt    DateTime @default(now())
  freshness        Float    @default(1.0)

  @@index([domain])
}

/// Training pipeline run results (nightly training history).
model AikeTrainingRun {
  id                   String   @id @default(cuid())
  runId                String   @unique
  startedAt            DateTime @default(now())
  completedAt          DateTime?
  durationMs           BigInt   @default(0)
  eventsProcessed      Int      @default(0)
  journeysRecognized   Int      @default(0)
  factsUpdated         Int      @default(0)
  gapsDetected         Int      @default(0)
  researchTasksCreated Int      @default(0)
  predictionsGenerated Int      @default(0)
  modelsEvaluated      Int      @default(0)
  improvementsPublished Int     @default(0)
  errors               String   @default("[]")
  status               String   @default("in_progress") // success | partial | failed | in_progress

  @@index([startedAt])
  @@index([status])
}

/// AI provider performance metrics (provider learning).
model AikeProviderMetrics {
  id             String   @id @default(cuid())
  provider       String   @unique // groq | openrouter | gemini | openai | huggingface
  accuracy       Float    @default(0.5)
  avgLatencyMs   Float    @default(0)
  costPer1k      Float    @default(0)
  arabicQuality  Float    @default(0.5)
  reasoningScore Float    @default(0.5)
  codeScore      Float    @default(0.5)
  visionScore    Float    @default(0.5)
  reliability    Float    @default(0.5)
  availability   Float    @default(0.5)
  totalCalls     Int      @default(0)
  updatedAt      DateTime @updatedAt
}

/// Discovered capabilities (capability learning).
model AikeDiscoveredCapability {
  id                    String   @id @default(cuid())
  discoveryId           String   @unique
  capabilityId          String
  type                  String   // api | model | plugin | government_integration | ...
  description           String
  provider              String
  coverage              String   @default("[]")
  integrationDifficulty Float    @default(0.5)
  estimatedValue        Float    @default(0.5)
  trustScore            Float    @default(50)
  status                String   @default("discovered") // discovered | evaluating | approved | rejected | integrated
  discoveredAt          DateTime @default(now())

  @@index([type, status])
  @@index([estimatedValue])
}

/// Model evaluation history.
model AikeModelEvaluation {
  id            String   @id @default(cuid())
  evaluationId  String   @unique
  modelName     String
  accuracy      Float
  precision     Float
  recall        Float
  f1Score       Float
  latencyMs     Float
  sampleSize    Int
  evaluatedAt   DateTime @default(now())
  recommendation String  // deploy | rollback | monitor | retrain

  @@index([modelName, evaluatedAt])
}

/// ============================================================
/// Circle ID / OIDC Provider models
/// (P1-1-OIDC — works ALONGSIDE existing localStorage auth;
///  no big-bang migration. See src/lib/oidc-provider.ts)
/// ============================================================

/// Registered OIDC client (RP — Relying Party).
/// Created via POST /api/oidc/register (RFC 7591 Dynamic Client Registration).
model OidcClient {
  id            String   @id @default(cuid())
  clientId      String   @unique
  clientSecret  String?
  name          String
  /// JSON-array of allowed redirect URIs (SQLite has no list type).
  redirectUris  String   @default("[]")
  /// JSON-array of allowed grant_types: ["authorization_code","refresh_token"]
  grantTypes    String   @default("authorization_code,refresh_token")
  /// JSON-array of allowed response_types: ["code"]
  responseTypes String   @default("code")
  /// JSON-array of allowed scopes.
  scope         String   @default("openid profile email")
  /// "confidential" | "public"
  clientType    String   @default("confidential")
  /// URI of client logo / icon (optional).
  logoUri       String?
  /// URI of client privacy policy (optional).
  policyUri     String?
  /// When the client was registered.
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions      OidcSession[]
  consents      OidcConsent[]

  @@index([clientType])
}

/// Authorization-code / token sessions issued by the OIDC provider.
/// One row per authorization code; access/refresh tokens are stored on
/// the same row to keep the chain of custody traceable.
model OidcSession {
  id              String   @id @default(cuid())
  clientId        String
  client          OidcClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  /// Cirkle username (subject) — the user who authorized.
  userLabel       String
  /// Random authorization code (short-lived, single-use).
  code            String   @unique
  codeChallenge   String?
  codeChallengeMethod String? // "S256" | "plain"
  /// Space-separated scopes that were granted.
  scope           String   @default("openid")
  /// Random nonce (sent by client, echoed in id_token).
  nonce           String?
  /// Opaque access token (random) used to look up this row at /userinfo.
  accessToken     String?  @unique
  /// Random refresh token (only issued when scope includes offline_access).
  refreshToken    String?  @unique
  /// ID token JWT (returned once at the token endpoint).
  idToken         String?
  /// PKCE / state binding — opaque to the server.
  state           String?
  /// "pending" | "issued" | "exchanged" | "revoked" | "expired"
  status          String   @default("pending")
  codeExpiresAt   DateTime
  accessExpiresAt DateTime?
  refreshExpiresAt DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([clientId, userLabel])
  @@index([userLabel])
  @@index([status])
}

/// Recorded user consents — a (user, client, scopes) tuple. Used to
/// skip the consent screen on subsequent authorizations for the same
/// client+scopes, and to support consent revocation.
model OidcConsent {
  id         String   @id @default(cuid())
  clientId   String
  client     OidcClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userLabel  String
  /// Space-separated scopes the user granted.
  scope      String   @default("openid")
  /// "granted" | "revoked"
  status     String   @default("granted")
  grantedAt  DateTime @default(now())
  revokedAt  DateTime?
  updatedAt  DateTime @updatedAt

  @@unique([clientId, userLabel])
  @@index([userLabel])
}

/// Circle Group — a private / public / anonymous community space.
/// (P1.7 — Circle Groups UX)
model CircleGroup {
  id              String   @id @default(cuid())
  name            String
  description     String   @default("")
  /// private | public | anonymous
  mode            String   @default("private")
  /// Social | Professional | Hobby | Community | Study | Sports
  category        String   @default("Social")
  avatarColor     String   @default("teal")
  avatarInitials  String   @default("C")
  encrypted       Boolean  @default(false)
  /// Owner username (creator). Used as the "owner label" on the
  /// membership roster — no FK to User so circles can exist without
  /// the user having a full User row yet.
  ownerLabel      String
  /// Space-separated settings flags:
  ///   joinApprovalRequired, membersCanPost, membersCanShareMedia,
  ///   membersCanInvite, membersCanCreateEvents
  settings        String   @default("joinApprovalRequired membersCanPost membersCanShareMedia")
  /// JSON-stringified list of invitation handles pending acceptance.
  pendingInvites  String   @default("[]")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  members         CircleMember[]

  @@index([ownerLabel])
  @@index([mode])
  @@index([category])
}

/// Circle Group membership roster. (P1.7)
/// One row per (circle, user) — role is owner | admin | moderator | member.
model CircleMember {
  id          String   @id @default(cuid())
  circleId    String
  circle      CircleGroup @relation(fields: [circleId], references: [id], onDelete: Cascade)
  /// Cirkle username (lowercase). Anonymous circles may store a
  /// pseudonymous handle here instead.
  userLabel   String
  /// owner | admin | moderator | member
  role        String   @default("member")
  joinedAt    DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([circleId, userLabel])
  @@index([circleId])
  @@index([userLabel])
}

/// Device public-key directory (P2.1 / ADR-002).
///
/// Stores ONLY the public halves of a user's device identity so peers can
/// encrypt messages to them. The private keys NEVER leave the client and are
/// never written to this table. The server treats `identityPublicKey` /
/// `signingPublicKey` as opaque JSON blobs — it does not parse them.
///
/// One row per (userLabel, deviceId). A user may publish multiple device
/// keys (phone + laptop); the client picks the most recent for encryption
/// unless it has a session pinned to a specific deviceId.
model DevicePublicKey {
  id                 String   @id @default(cuid())
  /// Cirkle username (lowercase) the device belongs to.
  userLabel          String
  /// Stable opaque device id from the client (e.g. `dev_a1b2c3...`).
  deviceId           String
  /// ECDH P-256 public key as JSON JWK. Future: Curve25519 from libolm.
  identityPublicKey  String
  /// ECDSA P-256 public key as JSON JWK. Future: Ed25519 from libolm.
  signingPublicKey   String
  /// 12-char hex fingerprint for SAS verification (ADR-002 §5.2).
  fingerprint        String
  publishedAt        DateTime @default(now())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([userLabel, deviceId])
  @@index([userLabel])
  @@index([fingerprint])
}

// ─────────────────────────────────────────────────────────────────────────────
// ActivityPub Federation (P2.3).
//
// `FederatedActor` records each local user's federated identity (their
// actor URL, public signing key, etc.). `Follow` records both inbound
// (someone is following a local user) and outbound (a local user is
// following someone) follow relationships. `FederatedActivity` is the
// activity log — every activity the local server sends or receives.
// ─────────────────────────────────────────────────────────────────────────────

model FederatedActor {
  id              String   @id @default(cuid())
  username        String   @unique // local username
  actorUri        String   @unique // https://circle.app/api/federation/actor/{username}
  inboxUri        String
  outboxUri       String
  followersUri    String
  followingUri    String
  /// E2EE signing public key (JWK JSON) — used to sign outgoing activities
  /// per ADR-002. The matching private key NEVER leaves the client.
  publicKeyJwk    String
  fingerprint     String
  summary         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([username])
}

model FederatedFollow {
  id           String   @id @default(cuid())
  /// Direction: "outbound" = local user follows remote actor;
  /// "inbound" = remote actor follows local user.
  direction    String
  /// Local username on this server.
  localUser    String
  /// Federated actor URI of the remote party.
  remoteActor  String
  remoteHandle String?  // user@domain for display
  accepted     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([direction, localUser, remoteActor])
  @@index([direction, localUser])
}

model FederatedActivity {
  id           String   @id @default(cuid())
  /// Stable activity URI (used as the ActivityPub `id` field).
  activityUri  String   @unique
  /// Local username that owns this activity (sender for outbound,
  /// recipient for inbound).
  owner        String
  direction    String   // "outbound" | "inbound"
  type         String   // Create|Update|Delete|Follow|Undo|Accept|Reject|Like|Announce
  /// JSON-serialised ActivityPub activity object.
  payload      String
  /// Optional link to the local Post this activity is about.
  postId       String?
  delivered    Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([owner, direction])
  @@index([type])
  @@index([postId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Community Governance (P2.4).
//
// `GovernanceProposal` is a community proposal (covenant changes, treasury
// spend, feature flags, moderation policy). `GovernanceVote` records each
// user's vote (one-vote-per-user). `ModerationAppeal` is an appeal against
// an automated moderation decision; `AppealVote` is the jury's vote.
// ─────────────────────────────────────────────────────────────────────────────

model GovernanceProposal {
  id          String   @id @default(cuid())
  title       String
  description String
  /// Proposal type: "covenant" | "treasury" | "feature" | "moderation" | "other"
  type        String   @default("other")
  author      String
  status      String   @default("voting") // voting|passed|rejected|closed
  /// ISO timestamp after which the proposal auto-closes.
  closesAt    DateTime
  yesVotes    Int      @default(0)
  noVotes     Int      @default(0)
  abstainVotes Int     @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  votes       GovernanceVote[]

  @@index([status])
  @@index([type])
  @@index([author])
}

model GovernanceVote {
  id          String   @id @default(cuid())
  proposalId  String
  proposal    GovernanceProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  voter       String
  /// "yes" | "no" | "abstain"
  vote        String
  /// E2EE signature of `${proposalId}|${vote}` — proves the vote came from
  /// the holder of the voter's signing key (ADR-002).
  signature   String?
  createdAt   DateTime @default(now())

  @@unique([proposalId, voter])
  @@index([proposalId, vote])
}

model ModerationAppeal {
  id          String   @id @default(cuid())
  /// ID of the moderated content (Post, Comment, etc.).
  contentId   String
  contentType String   @default("post") // post|comment|account
  /// Username filing the appeal.
  appellant   String
  reason      String
  /// Original moderation action being appealed.
  originalAction String
  status      String   @default("open") // open|upheld|overturned|closed
  upholdVotes    Int   @default(0)
  overturnVotes  Int   @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  votes       AppealVote[]

  @@index([status])
  @@index([appellant])
  @@index([contentId])
}

model AppealVote {
  id          String   @id @default(cuid())
  appealId    String
  appeal      ModerationAppeal @relation(fields: [appealId], references: [id], onDelete: Cascade)
  voter       String
  /// "uphold" | "overturn"
  vote        String
  signature   String?
  createdAt   DateTime @default(now())

  @@unique([appealId, voter])
  @@index([appealId, vote])
}

// ─────────────────────────────────────────────────────────────────────────────
// P2.5 — Decentralised Storage (IPFS abstraction).
//
// `StoragePin` records a content-addressed blob (CID = SHA-256 of content).
// The blob itself lives either in localStorage (small files, < 1MB) or on
// the server filesystem (large files). The upgrade path is a real IPFS
// node — the `cid` field is the IPFS CIDv1 equivalent so the migration is
// a no-op for callers.
// ─────────────────────────────────────────────────────────────────────────────

model StoragePin {
  id          String   @id @default(cuid())
  /// Content-addressed ID (multibase SHA-256 hex today, CIDv1 tomorrow).
  cid         String   @unique
  filename    String
  mimeType    String
  size        Int
  /// "local" (server filesystem) | "client" (localStorage only) | "ipfs" (future)
  storageTier String   @default("local")
  /// Relative path on the server filesystem for `local` tier. Null for
  /// `client` tier (the data lives only in the uploader's localStorage).
  filePath    String?
  /// Username of the original uploader.
  uploadedBy  String?
  pinned      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([uploadedBy])
  @@index([storageTier])
}

// ─────────────────────────────────────────────────────────────────────────────
// P2.6 — P2P Video (PeerTube abstraction).
//
// Videos are stored as `Post` rows with `module=mashahd` (the existing
// Mashahd module). `VideoSeed` records which devices are actively seeding
// a video via WebRTC (the existing mesh-network.ts layer). The upgrade
// path is a real PeerTube instance — the video metadata shape stays the
// same.
// ─────────────────────────────────────────────────────────────────────────────

model VideoSeed {
  id          String   @id @default(cuid())
  /// Post ID of the video being seeded.
  videoId     String
  /// Stable opaque device id from the seeding client.
  deviceId    String
  /// Optional username (when the seeder is logged in).
  username    String?
  /// WebRTC peer connection status.
  status      String   @default("active") // active|idle|closed
  /// Bitmask of which chunks the seeder has (bitmap hex). For chunked
  /// seeding future; today `ffff` means "full file".
  chunks       String   @default("ffff")
  lastSeen    DateTime @default(now())
  createdAt   DateTime @default(now())

  @@unique([videoId, deviceId])
  @@index([videoId, status])
  @@index([deviceId])
}

model VideoTranscode {
  id          String   @id @default(cuid())
  videoId     String
  /// "pending" | "processing" | "ready" | "failed"
  status      String   @default("pending")
  /// Output renditions JSON: [{resolution, bitrate, url}] when ready.
  renditions  String?
  progress    Int      @default(0) // 0..100
  error       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([videoId])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────────────────────
// GAPS-BATCH-2 — Circle events/members/join-requests/audit + tipping +
// affiliate + sponsored hashtags + moderation queue + nearby photos.
// ─────────────────────────────────────────────────────────────────────────────

/// Circle Group events calendar (Blueprint §10.5.1).
/// One row per scheduled event in a Circle.
model CircleEvent {
  id          String   @id @default(cuid())
  circleId    String
  /// Cirkle username (lowercase) of the event creator.
  createdBy   String
  title       String
  description String   @default("")
  /// Optional physical / virtual location label (free text).
  location    String?
  /// ISO date+time the event starts.
  startsAt    DateTime
  /// ISO date+time the event ends (optional — defaults to startsAt + 1h
  /// on the API side when omitted).
  endsAt      DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rsvps       EventRSVP[]

  @@index([circleId, startsAt])
  @@index([createdBy])
}

/// Per-user RSVP state for a CircleEvent.
/// One row per (event, user) — status: going | maybe | not_going.
model EventRSVP {
  id        String   @id @default(cuid())
  eventId   String
  event     CircleEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  /// Cirkle username (lowercase) of the responder.
  userLabel String
  /// going | maybe | not_going
  status    String   @default("going")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventId, userLabel])
  @@index([eventId, status])
  @@index([userLabel])
}

/// Join request to a private Circle (Blueprint §10.5.7).
/// One row per (circle, requester) until approved/denied.
model CircleJoinRequest {
  id         String   @id @default(cuid())
  circleId   String
  /// Cirkle username (lowercase) of the user requesting to join.
  userLabel  String
  /// Optional note from the requester to the circle owner/admin.
  note       String   @default("")
  /// pending | approved | denied
  status     String   @default("pending")
  /// Username of the admin who reviewed the request (null while pending).
  reviewedBy String?
  reviewedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([circleId, userLabel])
  @@index([circleId, status])
  @@index([userLabel])
}

/// Circle audit log (Blueprint §10.5.8).
/// Records all admin/role/settings/membership mutations in a Circle for
/// transparency. One row per auditable action.
model CircleAuditLog {
  id         String   @id @default(cuid())
  circleId   String
  /// "member_joined" | "member_left" | "role_changed" | "settings_changed"
  /// | "event_created" | "event_removed" | "join_request_approved"
  /// | "join_request_denied" | "circle_created"
  action     String
  /// Username of the actor performing the action.
  actor      String
  /// Username of the target of the action (e.g. the member whose role
  /// changed). May be null for circle-wide actions (settings_changed).
  target     String?
  /// Human-readable summary of the action + before/after state.
  summary    String
  createdAt  DateTime @default(now())

  @@index([circleId, createdAt])
  @@index([action])
}

/// Creator tip (Blueprint §7.4).
/// One row per tip sent from one Cirkle user to a creator.
model CreatorTip {
  id          String   @id @default(cuid())
  /// Cirkle username (lowercase) of the sender.
  fromUser    String
  /// Cirkle username (lowercase) of the receiving creator.
  toCreator   String
  amount      Float
  currency    String   @default("USD")
  /// Payment method id (e.g. "fawry", "stc-pay", "stripe", "usdc").
  method      String
  /// Platform processing fee (in same currency as amount).
  fee         Float    @default(0)
  /// Net amount the creator receives (amount - fee).
  netAmount   Float    @default(0)
  /// "pending" | "completed" | "failed" | "refunded"
  status      String   @default("completed")
  /// Optional message attached to the tip.
  message     String?
  createdAt   DateTime @default(now())

  @@index([toCreator, status])
  @@index([fromUser])
  @@index([method])
}

/// Affiliate click tracking (Blueprint §7.3.2).
/// One row per click on a creator's affiliate link.
model AffiliateClick {
  id           String   @id @default(cuid())
  /// Cirkle username (lowercase) of the affiliate creator.
  affiliateId  String
  /// Optional product/order identifier the click was for.
  productId    String?
  /// Best-effort country code of the clicker (no user id — privacy).
  country      String?
  /// Referrer URL or "direct" — never personal data.
  referrer     String?
  createdAt    DateTime @default(now())

  @@index([affiliateId, createdAt])
  @@index([productId])
}

/// Affiliate sale tracking (Blueprint §7.3.2).
/// One row per purchase attributed to a creator's affiliate link.
model AffiliateSale {
  id           String   @id @default(cuid())
  affiliateId  String
  /// Merchant order id (opaque to Cirkle — we only store attribution).
  orderId      String
  /// Total order amount (in `currency`).
  amount       Float
  currency     String   @default("USD")
  /// Commission rate the creator earns (0..1). e.g. 0.05 = 5%.
  commissionRate Float  @default(0.05)
  /// Commission the creator earned on this sale (amount * rate).
  commission   Float    @default(0)
  /// "pending" | "confirmed" | "paid" | "cancelled"
  status       String   @default("pending")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([affiliateId, orderId])
  @@index([affiliateId, status])
}

/// Sponsored hashtag (Blueprint §7.3.5).
/// A paid-for promoted hashtag shown in the Midan trending rail.
/// Non-targeted (city-level only) per Blueprint §30.4 — no user profiling.
model SponsoredHashtag {
  id              String   @id @default(cuid())
  /// The hashtag (without #) being sponsored.
  tag             String
  /// Advertiser name shown in the disclosure.
  advertiser      String
  /// Target country code (ISO-2). Required.
  targetCountry   String
  /// Optional target city (null = nationwide).
  targetCity      String?
  /// Optional category label (e.g. "Tech", "Food").
  category        String?
  /// Headline displayed on the trending card.
  headline        String
  /// Click-through URL.
  url             String
  /// Sponsored CPM budget (best-effort settlement, like ad-engine).
  budget          Float    @default(0)
  spent           Float    @default(0)
  impressions     Int      @default(0)
  clicks          Int      @default(0)
  startDate       DateTime
  endDate         DateTime
  status          String   @default("active") // active | paused | ended | exhausted
  createdAt       DateTime @default(now())

  @@index([targetCountry, status, startDate, endDate])
  @@index([tag])
}

/// NSFW / content moderation flag (Blueprint §8.8).
/// One row per piece of content flagged for human review.
/// (On-device NSFW model is deferred per ADR-003; the queue + workflow
/// ships now.)
model ModerationFlag {
  id           String   @id @default(cuid())
  /// ID of the moderated content (Post id, Comment id, etc.).
  contentId    String
  /// "post" | "comment" | "account" | "message"
  contentType  String   @default("post")
  /// Username of the flagger. May be "system" when auto-flagged.
  flaggedBy    String   @default("system")
  /// Reason category: "nsfw" | "spam" | "harassment" | "violence" |
  /// "illegal" | "other".
  reason       String
  /// Optional free-text note from the flagger.
  note         String?
  /// "pending" | "approved" | "removed" | "blurred" | "dismissed"
  status       String   @default("pending")
  /// Username of the moderator who reviewed (null while pending).
  reviewedBy   String?
  /// Moderator's note explaining the decision.
  reviewNote   String?
  reviewedAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  appeals      ModerationActionAppeal[]

  @@index([status, createdAt])
  @@index([contentId])
  @@index([contentType])
}

/// Appeal against a moderation decision (Blueprint §8.8).
/// One row per appeal filed by a user against a ModerationFlag decision.
/// (Distinct from the P2.4 `ModerationAppeal` model — that one is the
/// governance jury-voted appeal against automated moderation; this one
/// is the §8.8 single-user appeal workflow.)
model ModerationActionAppeal {
  id         String   @id @default(cuid())
  flagId     String
  flag       ModerationFlag @relation(fields: [flagId], references: [id], onDelete: Cascade)
  /// Username filing the appeal (the content's author).
  appellant  String
  reason     String
  /// "open" | "upheld" | "overturned" | "closed"
  status     String   @default("open")
  /// Moderator note on the appeal decision.
  decisionNote String?
  decidedBy  String?
  decidedAt  DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([flagId, status])
  @@index([appellant])
}

/// Privacy-preserving geohash index for nearby photo discovery
/// (Blueprint §8.4). Stores ONLY the geohash — never exact coordinates.
/// A geohash of precision 7 (~153m × 153m cells) is precise enough for
/// discovery within a city block while preventing exact re-identification.
model GeoPhotoIndex {
  id         String   @id @default(cuid())
  /// Post id this geo entry is for (Post with module=lamahat).
  postId     String
  /// Geohash string (lowercase base32). Precision 6 (~1.2km × 0.6km)
  /// by default — provides strong k-anonymity (100s of users per cell
  /// in dense areas). The client never sends the original lat/lng to
  /// the server; it computes the geohash locally and sends only that.
  geohash    String
  /// Best-effort country code (for region scoping queries).
  country    String?
  createdAt  DateTime @default(now())

  @@unique([postId])
  @@index([geohash])
  @@index([country, geohash])
}

/// Offline content stash item (Blueprint §8.9 / §26).
/// Stores a server-side copy of content (post, article, video, audio,
/// wiki page, URL) the user has saved for offline access. Items are
/// created on the client when the user taps "Save for offline" and
/// synced up to the server when connectivity returns. The stash is
/// per-user (`userLabel`) and content-addressable via `contentHash`
/// for dedup. A best-effort `expiresAt` enforces a retention window
/// (§26 — data minimisation): clients SHOULD prune expired items
/// locally, and the server MAY purge expired rows on read.
model OfflineStashItem {
  id          String   @id @default(cuid())
  /// Owner handle (lowercase, no leading @).
  userLabel   String
  /// "post" | "article" | "video" | "audio" | "wiki" | "url" | "lamahat" | "midan"
  contentType String
  /// Server-side id of the source content when known (nullable for
  /// arbitrary URL stash).
  contentId   String?
  /// Snapshot fields for offline display (so the client doesn't need
  /// a second round-trip to render the stashed item).
  title       String?
  body        String?
  mediaUrl    String?
  sourceUrl   String?
  /// JSON-encoded blob (author, tags, duration, etc.).
  metadata    String?
  /// "pending" (queued for upload) | "synced" (server has copy) |
  /// "failed" (upload failed — retry) | "stale" (source changed).
  syncStatus  String   @default("pending")
  /// sha256 hex of canonical content for dedup. Null when the source
  /// is too large to hash on-device.
  contentHash String?
  /// Estimated payload size (bytes) — for offline storage budget UI.
  sizeBytes   Int      @default(0)
  /// Optional retention window. Null = no expiry.
  expiresAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  lastSyncedAt DateTime?

  @@unique([userLabel, contentType, contentHash])
  @@index([userLabel, syncStatus])
  @@index([userLabel, contentType])
  @@index([expiresAt])
}

/// Performance-based creator rewards (Blueprint §7.3.7).
/// Rewards are computed per period (e.g. "2024-01" for January) based on
/// engagement metrics (views, likes, comments, shares) across the creator's
/// posts. The pool is distributed proportionally to a weighted engagement
/// score. Payout is recorded once per period per creator; the row tracks
/// the computation inputs + the final payout amount.
model CreatorReward {
  id           String   @id @default(cuid())
  /// Cirkle username (lowercase) of the rewarded creator.
  username     String
  /// Period key — "YYYY-MM" (monthly) or "YYYY-Www" (weekly ISO).
  period       String
  /// Engagement inputs used to compute the reward (JSON string).
  /// Fields: views, likes, comments, shares, score, rank.
  metrics      String
  /// Weighted engagement score (raw, for ranking + proportional split).
  score        Float    @default(0)
  /// Rank in the leaderboard for this period (1 = top creator).
  rank         Int      @default(0)
  /// Share of the period's reward pool (0..1).
  share        Float    @default(0)
  /// Final payout amount in `currency`.
  amount       Float    @default(0)
  currency     String   @default("USD")
  /// Total pool size for this period (denominator of share).
  poolSize     Float    @default(0)
  /// "computed" (leaderboard written, payout pending) |
  /// "distributed" (payout recorded) | "failed" (computation error).
  status       String   @default("computed")
  /// When the reward was distributed (null until payout).
  distributedAt DateTime?
  /// Optional payment reference (Commit hash, bank transfer id, etc.).
  paymentRef   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([username, period])
  @@index([period, rank])
  @@index([username, period])
  @@index([status])
}

/// Photo collection / Moment album (Blueprint §8.6.2 / §8.6.3).
/// A collection is a curated album of Lamahat photos (posts) assembled by
/// a user. Collections can be private (default) or shared with named
/// collaborators. "Moments" are a special kind of permanent album
/// (kind=moment) — distinct from ephemeral stories — that showcases a
/// curated set of photos around a theme or event.
model PhotoCollection {
  id          String   @id @default(cuid())
  /// Owner handle (lowercase, no leading @).
  ownerLabel  String
  /// "collection" (curated album) | "moment" (permanent themed album).
  kind        String   @default("collection")
  title       String
  /// Optional longer description / caption for the album.
  description String?
  /// JSON-encoded array of Post ids that belong to this collection.
  /// Stored as a string because SQLite lists are not supported.
  postIds     String   @default("[]")
  /// Cover gradient class string (e.g. "from-amber-500 via-orange-600 to-rose-700")
  /// so the UI can render a deterministic cover without an extra round-trip.
  cover       String   @default("")
  /// "private" (only owner) | "shared" (named collaborators) | "public".
  visibility  String   @default("private")
  /// JSON-encoded array of collaborator handles (lowercase).
  collaborators String @default("[]")
  /// Optional theme/category tag (Travel, Food, Nature, ...).
  category    String?
  pinned      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([ownerLabel, kind])
  @@index([ownerLabel, visibility])
  @@index([kind, visibility])
}
